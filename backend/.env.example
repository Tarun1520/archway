# =============================================================================
# Archway backend: settings template (NAMES ONLY, no real values)
# =============================================================================
# How to use:
#   1. Copy this file to  backend/.env
#   2. Fill in the values in backend/.env
# backend/.env is ignored by git. This example file is safe to commit because
# it contains no secrets.
#
# Every name here is read by backend/app/config/settings.py, which also checks
# the values when the server starts.
# -----------------------------------------------------------------------------

# --- Service modes: "fixture" (recorded data, free) or "live" ----------------
JEV_MODE=fixture
LLM_MODE=fixture
GITHUB_MODE=fixture

# --- Per-run call caps (REQUIRED: the server refuses to start without them) --
MAX_LLM_CALLS_PER_RUN=
MAX_JEV_CALLS_PER_RUN=

# --- LLM provider (needed only when LLM_MODE=live) ---------------------------
LLM_PROVIDER=
LLM_MODEL=
GROQ_API_KEY=
# Azure OpenAI: LLM_PROVIDER=azure, LLM_MODEL = the deployment name
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# --- Jev decision service (needed only when JEV_MODE=live) -------------------
JEV_API_KEY=

# --- GitHub token (optional; raises the API rate limit) ----------------------
GITHUB_TOKEN=

# --- Optional overrides ------------------------------------------------------
# Where the SQLite database lives. Default: backend/data.nosync
# ARCHWAY_DATA_DIR=
# LOG_LEVEL=INFO

# Optional: switches on general web search for the research scouts (api.search.brave.com, free tier).
BRAVE_API_KEY=

# Decisions (Phase 4) through Vercel AI Gateway. JEV_MODE=live needs the key.
AI_GATEWAY_API_KEY=
DECISION_PROVIDER=laya
DECISION_URL=http://127.0.0.1:8100
DECISION_MODEL=typed-decisions
# Eligibility policy: permissive (excludes GPL/AGPL) or copyleft_ok
LICENSE_POLICY=permissive
EXCLUDE_ARCHIVED=true

# Voice (ARCHY): speech to text and text to speech, from deepgram.com (free $200 credit, no card).
# Without it, voice is switched off. The key stays in the backend and is never sent to the browser.
DEEPGRAM_API_KEY=
# Which voice ARCHY speaks with: aura-2-thalia-en, aura-2-apollo-en, aura-2-arcas-en, aura-2-helena-en, ...
ARCHY_VOICE=aura-2-thalia-en
# Optional quick model for Archy's tiny questions (Groq; needs GROQ_API_KEY). Leave unset to use the main model.
# VOICE_LLM_MODEL=openai/gpt-oss-120b

# --- Accounts (sign-in and admin) ---------------------------------------------
# AUTH_ENABLED=false turns sign-in off (one local admin owns everything).
AUTH_ENABLED=true
# The account that signs up with this email becomes the admin.
ADMIN_EMAIL=
# true wherever the site is served over HTTPS (the deployed site); false on localhost.
# On HTTPS this also turns on HSTS, the __Host- cookie name, and hides the API docs.
COOKIE_SECURE=false
# The site(s) allowed to send changes and open the voice WebSocket, comma-separated (e.g. https://archway.vercel.app).
# localhost is always allowed when COOKIE_SECURE=false.
ALLOWED_ORIGINS=
# Where the browser opens the voice WebSocket when the site is on Vercel (which cannot forward WebSockets),
# e.g. wss://152-67-1-2.sslip.io. Empty: the page's own address.
VOICE_SOCKET_URL=

# Forgot password: reset links by email through Brevo (brevo.com, free plan: 300 emails a day, no card).
# MAIL_FROM must be verified in Brevo (Senders). Without both, "Forgot password?" is hidden.
BREVO_API_KEY=
MAIL_FROM=
# The site address used in the emailed link. Empty: the first ALLOWED_ORIGINS entry.
PUBLIC_SITE_URL=
# The interactive API docs at /docs: leave unset for "on locally, off on HTTPS".
# API_DOCS=true
SESSION_DAYS=30
# Model tokens (not API tokens) a new account may use per month; the admin can change it per person. 0 = no limit.
DEFAULT_MONTHLY_QUOTA=2000000
